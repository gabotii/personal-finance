# Copy to .env and adjust. Never commit .env.

# development | production  (production enforces a strong SECRET_KEY and PostgreSQL)
APP_ENV=development

# PostgreSQL (used by the db container and by the backend URL below)
POSTGRES_DB=personal_finance
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/personal_finance
# Local development without Docker can use SQLite instead:
# DATABASE_URL=sqlite:///./dev.db

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keys the session-token hashes; changing it signs everybody out.
SECRET_KEY=change-this

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

DEFAULT_CURRENCY=CLP
DEFAULT_TIMEZONE=America/Santiago

# Set to true when the app is served over HTTPS (required in real deployments).
COOKIE_SECURE=false
# OpenAPI docs at /docs (disabled by default when APP_ENV=production).
ENABLE_DOCS=true

LOG_LEVEL=INFO
WEB_CONCURRENCY=2
FRONTEND_PORT=8080
BACKEND_PORT=8000
